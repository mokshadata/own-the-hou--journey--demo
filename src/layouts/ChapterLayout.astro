---
import "../styles/global.css";
// import "../styles/journey-vars.css";
// import "../styles/journey-colors.css";
// import "../styles/journey-theme.css";
import { ClientRouter } from "astro:transitions";

import Paging from "../components/paging";

import {
  SidebarProvider, SidebarTrigger, Sidebar, SidebarContent,
  SidebarHeader, SidebarFooter, SidebarGroup,
} from "~/components/ui/sidebar";

// import Search from "../components/search";
// import SearchResults from "../components/search-results";
import JourneyBookMap from "../components/map/book-map";
import BookMapToggle from "~/components/map/book-map-toggle";

const {
  chaptersWithSections,
  activeChapter,
  activeSection,
  title,
  activeTitles,
  pageType,
  chapter,
  activePage,
  section,
} = Astro.props;
const base_url = `${import.meta.env.BASE_URL}`;
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Own the HOU Journey: {title}</title>
    <meta name="robots" content="noindex" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DLL3R76Z6B"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-DLL3R76Z6B');
    </script>
    <script type="text/javascript">
      window._mfq = window._mfq || [];
      (function() {
        var mf = document.createElement("script");
        mf.type = "text/javascript"; mf.defer = true;
        mf.src = "//cdn.mouseflow.com/projects/de761a2e-ecaa-40ca-909e-68d5d2deb39b.js";
        document.getElementsByTagName("head")[0].appendChild(mf);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base_url}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <!-- <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/versions/bulma-no-dark-mode.css"
    /> -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/flexboxgrid/6.3.1/flexboxgrid.min.css"
      type="text/css"
    />
    <!-- <link rel="stylesheet" href={`${base_url}assets/styles.css`} /> -->
    <!-- <ClientRouter /> -->
  </head>
  <body>
    <SidebarProvider client:load>
      <Sidebar client:load>
        <SidebarHeader class="p-0">
    <header data-theme="dark">
      <nav role="navigation" aria-label="main navigation">
        <ul>
          <li class="brand">
            <a href={base_url}>
              <img
                src="https://ownthehou.org/wp-content/themes/twentytwentyfive--own-the-hou/assets/images/logo-header.svg"
              />
            </a>
            <span>Toolkit</span>
          </li>
        </ul>
        <BookMapToggle client:only="solid-js"/>
      </nav>
    </header>
        </SidebarHeader>
        <SidebarContent>
          <SidebarGroup>
            <nav class="w-full">
              <JourneyBookMap
                activeChapter={activeChapter}
                activePage={activePage}
                activeSection={activeSection}
                journeyMap={chaptersWithSections}
                base_url={base_url}
                client:only="solid-js"
              />
            </nav>
          </SidebarGroup>
        </SidebarContent>
        <SidebarFooter class="p-0">
    <header data-theme="dark">
      <nav role="navigation" aria-label="footer navigation">
        <ul>
          <li>
            <a href="https://ownthehou.org/">Home</a>
          </li>
          <li>
            <a href="https://ownthehou.org/contact-us/" target="_blank">
              Contact Us
            </a>
          </li>
        </ul>
      </nav>
    </header>
        </SidebarFooter>
      </Sidebar>
      <main class="main--layout">
        <!-- <div class="row">
          <SearchResults client:only="solid-js"/>
          </div> -->
          <div class="w-full lg:max-w-4xl">
            <div class={`book--area ${pageType}`} data-chapter={chapter}>
              <slot name="book--header" />
              <p class="book--breadcrumb">
                <SidebarTrigger client:only="solid-js"/><strong>{activeTitles.chapter}</strong>
                <i>{activeTitles.section}</i>
              </p>
              <input type="hidden" name="active-titles" value={JSON.stringify(activeTitles)} data-has={Object.keys(activeTitles).join(' ')}>
              <div class={`${pageType}--content book--content`}>
                <slot />
              </div>
            </div>
            <Paging
              prevPage={Astro.props.prevPage}
              nextPage={Astro.props.nextPage}
              nextPageOptions={Astro.props.nextPageOptions}
              journeyMap={chaptersWithSections}
              module={activePage}
              chapter={chapter}
              section={section || activeSection}
              baseURL={base_url}
              client:only="solid-js"
            />
          </div>
      </main>
    </SidebarProvider>
<script type="text/javascript" src="https://cdn.weglot.com/weglot.min.js"></script>
<script>
    Weglot.initialize({
        api_key: 'wg_0cf37b27fc0d7af59a5a42025ea85bc37'
    });
</script>
  </body>
</html>
