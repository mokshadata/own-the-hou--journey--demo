---
// import "../styles/global.css";
import "../styles/journey-vars.css";
import "../styles/journey-colors.css";
import "../styles/journey-theme.css";
import { ClientRouter } from "astro:transitions";

import Paging from "../components/paging";

const { chaptersWithSections, activeChapter, activeSection, title, activeTitles, pageType, chapter, activePage } = Astro.props;
const base_url = `${import.meta.env.BASE_URL}`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Own the HOU Journey: {title}</title>
    <meta name="robots" content="noindex">
    <link rel="icon" type="image/svg+xml" href={`${base_url}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <!-- <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/versions/bulma-no-dark-mode.css"
    /> -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"
    >
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flexboxgrid/6.3.1/flexboxgrid.min.css" type="text/css" >
    <!-- <link rel="stylesheet" href={`${base_url}assets/styles.css`} /> -->
    <ClientRouter />
  </head>
  <body>
    <header>
      <nav
        role="navigation"
        aria-label="main navigation"
      >
        <div>
          <a href={base_url}>
            <img
              src="https://ownthehou.org/wp-content/themes/twentytwentyfive--own-the-hou/assets/images/logo-header.svg"
            />
          </a>
        </div>
      </nav>
    </header>
    <main class="main--layout">
      <div class="row">
        <nav class="col-xs-12 col-md-3">
          <aside class="menu journey-map" data-mode="side">
            <ol class="menu-list">
              {
                chaptersWithSections.map((topLevel) => (
                  <li>
                    <a
                      role="link"
                      data-menu-type="chapter"
                      class={topLevel.chapter === activeChapter && 'is-active' || ''}
                      href={`${base_url}chapters/${topLevel.chapter}/`}
                    ><div>{topLevel.title}</div></a>
                    <ol class={topLevel.chapter !== activeChapter && 'is-hidden' || ''}>
                      {topLevel.sections.map((midLevel) => (
                        <li>
                          <a
                            role="link"
                            data-menu-type="section"
                            class={midLevel.section === activeSection && 'is-active' || ''}
                            href={`${base_url}chapters/${topLevel.chapter}/${midLevel.section}/${ midLevel.modules.length && `${midLevel.modules[0].module}/` || ''}`}
                          >{midLevel.title}</a>
                          <ol class={midLevel.section !== activeSection && 'is-hidden' || ''}>
                            {midLevel.modules.filter((pageLevel) => (pageLevel.item)).map((pageLevel) => (
                              <li>
                                <a
                                  role="link"
                                  data-menu-type="page"
                                  class={pageLevel.module === Astro.props.activePage && 'is-active' || ''}
                                  href={`${base_url}chapters/${topLevel.chapter}/${midLevel.section}/${pageLevel.module}/`}
                                >{pageLevel.item.data.name}</a>
                              </li>
                            ))}
                          </ol>
                        </li>
                      ))}
                      <li>
                        <a
                          role="link"
                          data-menu-type="section"
                          class={'Review' === Astro.props.activeSection && 'is-active' || ''}
                          href={`${base_url}chapters/${topLevel.chapter}/review/`}
                        >Check-In</a>
                      </li>
                    </ol>
                  </li>
                ))
              }
            </ol>
          </aside>
        </nav>
        <div class="col-xs-12 col-md-9 col-lg-7">
          <div class={`book--area ${pageType}`} data-chapter={chapter}>
            <p class="book--breadcrumb"><strong>{activeTitles.chapter}</strong> <i>{activeTitles.section}</i></p>
            <div class={`${pageType}--content book--content`}>
              <slot />
            </div>
          </div>
          <Paging
            prevPage={Astro.props.prevPage}
            nextPage={Astro.props.nextPage}
            nextPageOptions={Astro.props.nextPageOptions}
            module={activePage}
            chapter={chapter}
            baseURL={base_url}
            client:only="solid-js"
          />
        </div>
      </div>
    </main>
  </body>
</html>
