---
// import "../styles/global.css";
import "../styles/journey.css";
import { ClientRouter } from "astro:transitions";

const { chaptersWithSections, activeChapter, activeSection, title, activeTitles } = Astro.props;
const base_url = `${import.meta.env.BASE_URL}`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Own the HOU Journey: {title}</title>
    <meta name="robots" content="noindex">
    <link rel="icon" type="image/svg+xml" href={`${base_url}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/versions/bulma-no-dark-mode.css"
    />
    <link rel="stylesheet" href={`${base_url}assets/styles.css`} />
    <ClientRouter />
  </head>
  <body class="has-navbar-fixed-top">
    <header>
      <nav
        class="navbar is-fixed-top has-background-primary has-text-white-bis"
        role="navigation"
        aria-label="main navigation"
      >
        <div class="navbar-brand">
          <a class="navbar-item" href={base_url}>
            <img
              src="https://ownthehou.org/wp-content/themes/twentytwentyfive--own-the-hou/assets/images/logo-header.svg"
            />
          </a>
        </div>
      </nav>
    </header>
    <main class="container is-fluid">
      <div class="columns">
        <nav class="column is-one-third">
          <aside class="menu journey-map p-4">
            <p class="menu-label">Your Journey</p>
            <ul class="menu-list">
              {
                chaptersWithSections.map((topLevel) => (
                  <li>
                    <a
                      data-menu-type="chapter"
                      class={topLevel.chapter === activeChapter && 'is-active' || ''}
                      href={`${base_url}chapters/${topLevel.chapter}/`}
                    >{topLevel.title}</a>
                    <ul class={topLevel.chapter !== activeChapter && 'is-hidden' || ''}>
                      {topLevel.sections.map((midLevel) => (
                        <li>
                          <a
                            data-menu-type="section"
                            class={midLevel.section === activeSection && 'is-active' || ''}
                            href={`${base_url}chapters/${topLevel.chapter}/${midLevel.section}/${ midLevel.modules.length && `${midLevel.modules[0].module}/` || ''}`}
                          >{midLevel.title}</a>
                          <ul class={midLevel.section !== activeSection && 'is-hidden' || ''}>
                            {midLevel.modules.filter((pageLevel) => (pageLevel.item)).map((pageLevel) => (
                              <li>
                                <a
                                  data-menu-type="page"
                                  class={pageLevel.module === Astro.props.activePage && 'is-active' || ''}
                                  href={`${base_url}chapters/${topLevel.chapter}/${midLevel.section}/${pageLevel.module}/`}
                                >{pageLevel.item.data.name}</a>
                              </li>
                            ))}
                          </ul>
                        </li>
                      ))}
                      <li>
                        <a
                          data-menu-type="page"
                          class={'Review' === Astro.props.activeSection && 'is-active' || ''}
                          href={`${base_url}chapters/${topLevel.chapter}/review/`}
                        >Check-In</a>
                      </li>
                    </ul>
                  </li>
                ))
              }
            </ul>
          </aside>
        </nav>
        <article class="column">
          <div class="p-6 mt-6">
            <p class="book--breadcrumb"><strong>{activeTitles.chapter}</strong> <i>{activeTitles.section}</i></p>
            <slot />
          </div>
          <nav
            class="pt-4 grid"
            role="navigation"
            aria-label="pagination"
          >
            <div class="cell">
              {Astro.props.prevPage && <a
                href={`${base_url}chapters/${[Astro.props.prevPage.params.chapter, Astro.props.prevPage.params.section, Astro.props.prevPage.params.module].filter((param) => param).join('/')}/`}
                class="button py-3 is-flex is-justify-content-flex-end is-justify-content-space-between"
                aria-label="Previous"
              >
                <div class="is-flex is-flex-direction-column is-align-items-flex-end">
                  <small class="has-text-right has-text-weight-normal"><strong>{Astro.props.prevPage.props.chapterTitle}</strong> <i>{Astro.props.prevPage.props.sectionTitle}</i></small><strong class="has-text-right is-size-5">{Astro.props.prevPage.props.moduleTitle}</strong>
                </div>
              </a> || ''}
            </div>
            <div class="cell">
              {Astro.props.nextPage && <a
                href={`${base_url}chapters/${[Astro.props.nextPage.params.chapter, Astro.props.nextPage.params.section, Astro.props.nextPage.params.module].filter((param) => param).join('/')}/`}
                class="button py-3 is-flex is-justify-content-flex-start is-justify-content-space-between"
                aria-label="Next"
              >
                <div class="is-flex is-flex-direction-column is-align-items-flex-start">
                  <small class="has-text-left has-text-weight-normal"><strong>{Astro.props.nextPage.props.chapterTitle}</strong> <i>{Astro.props.nextPage.props.sectionTitle}</i></small><strong class="has-text-left is-size-5">{Astro.props.nextPage.props.moduleTitle}</strong>
                </div>
              </a> || ''}
            </div>
          </nav>
        </article>
      </div>
    </main>
    <footer></footer>
  </body>
</html>
