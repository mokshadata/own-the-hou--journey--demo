---
// import "../styles/global.css";
import "../styles/journey-vars.css";
import "../styles/journey-colors.css";
import "../styles/journey-theme.css";
import { ClientRouter } from "astro:transitions";

import Image from "astro/components/Image.astro";

import familyInHomeImage from '../assets/images/family-in-home.jpg'
import keyImage from '../assets/images/The-One.jpg'

import JourneyMap from "../components/map/component.tsx";

import Paging from "../components/paging";

import BookDecisions from "../components/decisions/";

import ModelWrapper from "../components/model-wrapper";
import { key } from "localforage";

import {
  PersonaStep01Diagram,
  PersonaStep02Diagram,
  PersonaStep03Diagram,
} from '../components/diagrams/index.tsx';

const { journeyMap } = Astro.props;
const base_url = `${import.meta.env.BASE_URL}`;

const options = [
  {
    option: 'homebuyer--00',
    label: "I don't know where to start.",
    detail: "I'm interested, but I don't know where to start.",
    icon: 'PersonaStep01Diagram',
    // <PersonaStep01/>,
  },
  {
    option: 'homebuyer--01',
    label: "I have started looking, but have not looked into financing yet.",
    detail: "I may be talking to a realtor but I have not yet looked at preapproval.",
    icon: 'PersonaStep02Diagram',
    // <PersonaStep02/>,
  },
  {
    option: 'homebuyer-02',
    label: "I'm in the process but I have challenges.",
    detail: "I am experiencing challenges with: Credit, mortgage, finding a realtor, finding options within my budget",
    icon: 'PersonaStep03Diagram',
    // <PersonaStep03/>,
  },
]


console.log({topOptions: options})

---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Own the HOU Journey: Your Map to Homeownership</title>
    <meta name="robots" content="noindex">
    <link rel="icon" type="image/svg+xml" href={`${base_url}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <!-- <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/versions/bulma-no-dark-mode.css"
    /> -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"
    >
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flexboxgrid/6.3.1/flexboxgrid.min.css" type="text/css" >
    <!-- <link rel="stylesheet" href={`${base_url}assets/styles.css`} /> -->
    <ClientRouter />
  </head>
  <body>
    <header>
      <nav
        role="navigation"
        aria-label="main navigation"
      >
        <div>
          <a href={base_url}>
            <img
              src="https://ownthehou.org/wp-content/themes/twentytwentyfive--own-the-hou/assets/images/logo-header.svg"
            />
          </a>
        </div>
      </nav>
    </header>
    <main class="map--layout">
      <div class="row map--intro">
        <div class="col-xs-12">
          <h1>Where are you on your home owning journey?</h1>
        </div>
      </div>
      <div class="row map--intro map--decisions">
        <!-- decision--c00-mapping--journey--phase -->
        <div class="col-xs-6">
          <a role="button" class="home-buyer--cover map--decision" style={{backgroundImage: `url(${keyImage.src});`}}>
            <span class="map--decision--cover--background"></span>
            <span class="button">I'm looking to buy a house.</span>
          </a>
        </div>
        <div class="col-xs-6">
          <a role="button" class="home-owner--cover map--decision" style={{backgroundImage: `url(${familyInHomeImage.src});`}}>
            <span class="map--decision--cover--background"></span>
            <span class="button">I'm a homeowner.</span>
          </a>
        </div>
      </div>
      <div class="row">
        <!-- <div class="col-xs-4">
          <PersonaStep01Diagram/>
        </div>
        <div class="col-xs-4">
          <PersonaStep02Diagram/>
        </div>
        <div class="col-xs-4">
          <PersonaStep03Diagram/>
        </div> -->
      </div>
      <div class="row">
        <div class="col-xs-12">
          <!-- <ModelWrapper storeName={'decision--c00-mapping--journey'}> -->
            <BookDecisions
              client:only="solid-js"
              legend="What best describes you?"
              name="decision--c00-mapping--journey--phase"
              readOnly={false}
              optionType="radio"
              options={options}
            >
          </BookDecisions>
          <!-- </ModelWrapper> -->
        </div>
      </div>
      <div class="row">
        <nav class="col-xs-12">
          <aside class="menu journey-map" data-mode="map">
            <JourneyMap client:only="solid-js" journeyMap={journeyMap} base_url={base_url}/>
          </aside>
        </nav>
      </div>
    </main>
  </body>
</html>
