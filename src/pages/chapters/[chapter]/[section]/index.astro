---
import ChapterLayout from '../../../../layouts/BulmaChapterLayout.astro';
import { getCollection, getEntry, getEntries, render } from 'astro:content';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  const structure = await Promise.all(chapters.map(async (chapter) => ({
      chapter: chapter.id,
      ...chapter.data,
      sections: (await getEntries(chapter.data.contains)).map((section) => ({
        section: section.id,
        ...section.data,
        modules: (section.data.contains).map((module) => ({
            module: module.id,
        }))
      })),
  })));

  const pageLookup = structure.map(({
      chapter, title: chapterTitle, order: chapterOrder,
      sections
    }) => ([
        {
            params: { chapter, },
            props: {
                chapterTitle, chapterOrder, sectionTitle: null, moduleTitle: 'Intro',
            },
        },
        ...sections.map(({ title: sectionTitle, order: sectionOrder, section, modules }) => (
    // modules.map(({ module, }) => (
            {
                params: { chapter, section, },
                props: {
                    chapterTitle, chapterOrder,
                    sectionTitle, sectionOrder,
                    structure,
                    modules,
                }
            }
        // ))
        )),
        {
            params: { chapter, section: 'review', },
            props: {
                chapterTitle, chapterOrder, sectionTitle: null, moduleTitle: 'Check-In',
            },
        },
    ]))
    .reduce((result, current) => ([...result, ...current]), [])
    .map((page, index, pages) => ({
      params: page.params,
      props: {
        ...page.props,
        nextPage: pages[index + 1],
        prevPage: pages[index - 1],
      }
    }))
    .filter((page) => (page.props.sectionTitle))
    
  return pageLookup
}

const { 
    chapterTitle, chapterOrder,
    sectionTitle, sectionOrder,
    structure,
    modules,
} = Astro.props;

const { chapter, section, } = Astro.params;

async function getContent() {
  try {
    const introEntry = await getEntry('intros', `${chapter}--intro`)
    return await introEntry?.render()
  } catch (error) {
    return
  }
}

const intro = await getContent()
const base_url = `${import.meta.env.BASE_URL}`;

// const orderToAlpha = (sectionOrder) => ('abcdefghijklmnopqrstuvwxyz'[sectionOrder-1])
---
<script type="text/javascript" define:vars={{base_url, modules, chapter, section }}>
    if (modules.length) {
        window.location = `${base_url}./chapters/${chapter}/${section}/${modules[0].module}`
    }
</script>

<ChapterLayout
  chaptersWithSections={structure}
  activeChapter={chapter} activeSection={section}
  title={`${chapterTitle}: ${sectionTitle}`}
  chapter={chapter}
  nextPage={Astro.props.nextPage}
  prevPage={Astro.props.prevPage}
  pageType="chapter--section"
  activeTitles={{
    chapter: chapterTitle,
    section: sectionTitle,
  }}
>
  {intro && <intro.Content/> || <></>}
</ChapterLayout>
