---
import ChapterLayout from '../../../../layouts/ChapterLayout.astro';
import { getCollection, getEntry, getEntries, render } from 'astro:content';

import { getAllPages } from '../../../../helpers/chapters'

export async function getStaticPaths() {
  return (await getAllPages()).filter((page) => (page.params.module))
}


const { 
  chapterTitle, chapterOrder,
  sectionTitle, sectionOrder,
  moduleTitle, moduleOrder, moduleEntry, moduleLookup,
  structure,
  prevPage, nextPage, nextPageOptions,
 } = Astro.props;
// console.log('hello?', Astro.params)

const { chapter, section, module } = Astro.params;
const renderedSection = await render(moduleEntry)

const orderToAlpha = (sectionOrder) => ('abcdefghijklmnopqrstuvwxyz'[sectionOrder-1])
---
<ChapterLayout
  chaptersWithSections={structure}
  activeChapter={chapter} activeSection={section} activePage={module}
  title={`${chapterTitle}: ${sectionTitle}: ${moduleTitle}`}
  chapter={chapter}
  prevPage={prevPage} nextPage={nextPage} nextPageOptions={nextPageOptions}
  pageType="chapter--module"
  activeTitles={{
    chapter: chapterTitle,
    section: sectionTitle,
    module: moduleTitle,
  }}
>
  <h2 class="is-size-3 book--module-title">{moduleTitle}</h2>
  <p class="book--read-time">{renderedSection.remarkPluginFrontmatter.minutesRead}</p>
  <renderedSection.Content/>
</ChapterLayout>
