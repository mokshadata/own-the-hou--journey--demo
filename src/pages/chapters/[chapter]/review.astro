---
import ChapterLayout from '../../../layouts/ChapterLayout.astro';
import { getCollection, getEntry, getEntries, render } from 'astro:content';
import { getChapterReviews } from '../../../helpers/chapters'

import AnnualEstimator from '../../../components/calculators/annual-estimator/component';
import BookDecisions from '../../../components/decisions/component';

import YoutubePlayer from '../../../components/video/youtube';

import Map from "../../../assets/images/journey-map.png"
import { Image } from 'astro:assets';

export async function getStaticPaths() {
    return(await getChapterReviews())
}

const { 
    chapterTitle,
    structure,
    reviewItems,
} = Astro.props;

const { chapter, } = Astro.params;

async function getContent() {
  try {
    const reviewEntry = await getEntry('reviews', `${chapter}--review`)
    return await reviewEntry?.render()
  } catch (error) {
    return
  }
}

const review = await getContent()
const base_url = `${import.meta.env.BASE_URL}`;

console.log(reviewItems)
---
<ChapterLayout
  chaptersWithSections={structure}
  activeChapter={chapter}
  activeSection='Review'
  title={`${chapterTitle}: Review`}
  chapter={chapter}
  section="review"
  prevPage={Astro.props.prevPage}
  nextPage={Astro.props.nextPage}
  nextPageOptions={[]}
  pageType="chapter--review"
  activeTitles={{
    chapter: chapterTitle,
  }}
>
  <h2 class="is-size-3 book--module-title">Review</h2>
  {review && <p class="book--read-time">{review.remarkPluginFrontmatter.minutesRead}</p> || <></>}
  <div class="chapter--review--overview">
    <p>Below, you can review any decisions, terms, checklists, resources, and videos from throughout the chapter.</p>
  </div>
  {review && 
  <div class="chapter--review--summary">
    <h2>Summary</h2>
    <review.Content/>
  </div> || <></>}
  {reviewItems.decisions.length && (<div class="chapter--review--exercises">
    <h2>Decisions Made</h2>
    {
        reviewItems.decisions.map(({ nodeName, ...props }) => (
            nodeName === 'BookDecisions' &&  <BookDecisions
                client:only="solid-js"
                legend={props.legend}
                name={props.name}
                readOnly={true}
                optionType={props.optionType}
                options={eval(props.options.value)}
            /> || <></>))
    }
    {
        reviewItems.calculators.map(({ nodeName }) => (nodeName === 'AnnualEstimator' &&  <AnnualEstimator client:only="solid-js"/> || <></>))
    }
  </div>) || <></>}
  {reviewItems.terms.length && (<div class="chapter--review--terms">
    <h2>Terms</h2>
    <dl>
        {reviewItems.terms.map((term) => (
            <dt class="term--term">{term.lookup.data.term}</dt>
            <dd>{term.lookup.data.definition}</dd>
        ))}
    </dl>
  </div>) || <></>}
  {reviewItems.checklists.length && (<div class="chapter--review--checklists">
    <h2>Checklists</h2>
    <ul>
        {
            reviewItems.checklists
                .map((item) => (
                    <li>
                        <h5>{item.title}</h5>
                        <iframe id={item.id} src={item.src} width="100%" height="500px"></iframe>
                    </li>
                ))
        }
    </ul>
  </div>) || <></>}
  {reviewItems.videos.length && (<div class="chapter--review--videolist">
    <h2>Video Playlist</h2>
    <div class="chapter--review--videolist--playlist book--decision">
        {reviewItems.videos.map((item) => (
          <details>
            <summary>
              {item.alt}
            </summary>
            <YoutubePlayer
                baseSource={item.baseSource}
                alt={item.alt}
                slug={item.slug}
            />
          </details>
        ))}
    </div>
  </div>) || <></>}
  
</ChapterLayout>
