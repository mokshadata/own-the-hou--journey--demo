---
import ChapterLayout from '../../../layouts/BulmaChapterLayout.astro';
import { getCollection, getEntry, getEntries, render } from 'astro:content';

import AnnualEstimator from '../../../components/calculators/annual-estimator/component';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  const structure = await Promise.all(chapters.map(async (chapter) => ({
      chapter: chapter.id,
      ...chapter.data,
      terms: (await getCollection('terms', ({data}) => (data.chapter.id === chapter.id))),
      sections: (await getEntries(chapter.data.contains)).map((section) => ({
        section: section.id,
        ...section.data,
        modules: (section.data.contains).map((module) => ({
            module: module.id,
        }))
      })),
  })));

  const pageLookup = await Promise.all(structure.map(({
      chapter, title: chapterTitle, order: chapterOrder,
      terms,
      sections
    }) => (
        {
        params: { chapter, },
        props: {
            chapterTitle,
            structure,
            terms,
        }
        }
    ))
    .map(async (page, index, pages) => {
        let lastChapterModule

        if (structure[index].sections[structure[index].sections.length - 1].modules.length) {
            lastChapterModule = await getEntry('modules', structure[index].sections[structure[index].sections.length - 1].modules[structure[index].sections[structure[index].sections.length - 1].modules.length-1].module)
        }
        let base = {
            params: page.params,
            props: {
                ...page.props,
                prevPage: {
                    params: {
                        ...page.params,
                        section: structure[index].sections[structure[index].sections.length - 1].section,
                        module: structure[index].sections[structure[index].sections.length - 1].modules.length && structure[index].sections[structure[index].sections.length - 1].modules[structure[index].sections[structure[index].sections.length - 1].modules.length-1].module || null,
                    },
                    props: {
                        chapterTitle: structure[index].title,
                        chapterOrder: structure[index].order,
                        sectionTitle: structure[index].sections[structure[index].sections.length - 1].title,
                        moduleTitle: lastChapterModule?.data.name,

                    }
                }
            }
        }

        if (index < pages.length - 2) {
            base.props.nextPage = {
                params: {
                    chapter: structure[index+1].chapter,
                },
                props: {
                    chapterTitle: structure[index+1].title,
                    chapterOrder: structure[index+1].order,
                    moduleTitle: 'Intro',
                },
            }
        }

        return base
    }))
    
  return pageLookup
}

const { 
    chapterTitle,
    structure,
    terms,
} = Astro.props;

const { chapter, } = Astro.params;

async function getContent() {
  try {
    const reviewEntry = await getEntry('reviews', `${chapter}--review`)
    return await reviewEntry?.render()
  } catch (error) {
    return
  }
}

const review = await getContent()
---
<ChapterLayout
  chaptersWithSections={structure}
  activeChapter={chapter}
  activeSection='Review'
  title={`${chapterTitle}: Review`}
  prevPage={Astro.props.prevPage}
  nextPage={Astro.props.nextPage}

  activeTitles={{
    chapter: chapterTitle,
    section: 'Review',
  }}
>
  <h2 class="is-size-3 book--module-title">{chapterTitle} Review</h2>
  {review && <p class="book--read-time">{review.remarkPluginFrontmatter.minutesRead}</p> || <></>}
  <div class="chapter--review">
    <h2>Summary</h2>
      {review && <review.Content/> || <></>}
      <p>Below, you'll see the decisons you made, terms we learned, resources, and videos from throughout the chapter.</p>
  </div>
  <div class="chapter--review--exercises">
    <h2>Decisions Made</h2>
    <AnnualEstimator client:only="solid"/>
  </div>
  <div class="chapter--review--terms">
    <h2>Terms</h2>
    <dl>
        {terms.map((term) => (
            <dt class="term--term">{term.data.term}</dt>
            <dd>{term.data.definition}</dd>
        ))}
    </dl>
  </div>
  <div class="chapter--review--resources">
    <h2>Resources</h2>
    <h6>Calculating Monthly Home Costs</h6>
    <ul>
        <li>
            <a href="https://harris.trueprodigy-taxtransparency.com/taxTransparency/propertySearch" target="_blank">Harris Taxes Truth in Taxation database</a>
        </li>
        <li>
            <a href="https://ownthehou.org/latest-updates/" target="_blank">Own the HOU’s blog post on taxes for new construction homes</a>
        </li>
        <li>Flood risks in Houston and Harris County</li>
    </ul>
    <h6>Browsing Homes and Neighborhoods in Houston</h6>
    <ul>
        <li>
            <a href="https://www.har.com/" target="_blank">Houston Association of Realtors</a>
            <p>Great website for searching for homes in Houston. Standout features are.....</p>
        </li>
        <li>
            <a href="https://homes.com" target="_blank">Homes.com</a>, <a href="https://realtor.com" target="_blank">Realtor.com</a>, <a href="https://zillow.com" target="_blank">Zillow</a>, or <a href="https://redfin.com" target="_blank">Redfin</a> are great options as well.
        </li>
    </ul>
    <h6>
        Maximizing Your Home Budget
    </h6>
    <ul>
        <li>
            See whether you may qualify for <a href="https://forms.connectivetx.org/340" target="_blank">Down Payment Assistance</a>
        </li>
        <li>
            Learn more about credit scores and how they are calculated in <a href="https://www.nfcc.org/understanding-your-credit-score-course/" target="_blank">this lesson</a> from the National Foundation for Credit Counseling
        </li>
        <li>
            Free credit score reports from Experian, TransUnion and Equifax at <a href="https://annualcreditreport.com" target="_blank">annualcreditreport.com</a>
        </li>
        <li>
            Improve your credit score by
            <ul>
                <li>
                    taking classes and getting counseling in Houston at <a href="https://financialministries.org/" target="_blank">Alliance Financial Ministries</a>, or
                </li>
                <li>
                    looking up a local certified credit counselor at the <a href="https://www.nfcc.org/" target="_blank">National Foundation for Credit Counseling</a> website.
                </li>
            </ul>
        </li>
    </ul>

  </div>
  <div class="chapter--review--checklists">
    <h2>Checklists</h2>
  </div>
  <div class="chapter--review--videolist">
    <h2>Video Playlist</h2>
  </div>
  
</ChapterLayout>
