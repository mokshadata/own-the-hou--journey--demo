---
import ChapterLayout from '../../../layouts/ChapterLayout.astro';
import { getCollection, getEntry, getEntries, render } from 'astro:content';
import { getChapterIntros } from '../../../helpers/chapters'

import ChapterIntroGraphic from '../../../components/diagrams/chapter-intro'

export async function getStaticPaths() {
  return (await getChapterIntros())
}

const { 
    chapterTitle,
    structure,
} = Astro.props;

const { chapter, } = Astro.params;

async function getContent() {
  try {
    const introEntry = await getEntry('intros', `${chapter}--intro`)
    return await introEntry?.render()
  } catch (error) {
    return
  }
}

const intro = await getContent()
const search = Astro.url.searchParams.get('search') || '';
---
<ChapterLayout
  chaptersWithSections={structure}
  activeChapter={chapter}
  title={`${chapterTitle}: Introduction`}
  chapter={chapter}
  prevPage={Astro.props.prevPage}
  nextPage={Astro.props.nextPage}
  nextPageOptions={[]}
  pageType="chapter--intro"
  activeTitles={{
    chapter: chapterTitle,
  }}
>
  <!-- <h2 class="is-size-3 book--module-title">Introduction</h2> -->
    {intro && (
        <div class="chapter--intro--header" slot="book--header">
            <ChapterIntroGraphic chapterID={chapter}/>
            <h1>
                {chapterTitle}
            </h1>
        </div>
    ) || <></> }
    {intro && (
        <div class="chapter--intro--content">
            {intro && <p class="book--read-time">{intro.remarkPluginFrontmatter.minutesRead}</p> || <></>}
            <div class="book--content--body"><intro.Content/></div>
        </div>
    ) || <div class="chapter--intro--content"></div>}
</ChapterLayout>
