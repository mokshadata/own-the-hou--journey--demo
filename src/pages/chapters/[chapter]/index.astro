---
import ChapterLayout from '../../../layouts/BulmaChapterLayout.astro';
import { getCollection, getEntry, getEntries, render } from 'astro:content';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  const structure = await Promise.all(chapters.map(async (chapter) => ({
      chapter: chapter.id,
      ...chapter.data,
      sections: (await getEntries(chapter.data.contains)).map((section) => ({
        section: section.id,
        ...section.data,
        modules: (section.data.contains).map((module) => ({
            module: module.id,
        }))
      })),
  })));

  const pageLookup = await Promise.all(structure.map(({
      chapter, title: chapterTitle, order: chapterOrder,
      sections
    }) => (
        {
            params: { chapter, },
            props: {
                chapterTitle, chapterOrder,
                structure,
            }
        }
    ))
    .map(async (page, index, pages) => {
        let firstChapterModule

        if (structure[index].sections[0].modules.length) {
            firstChapterModule = await getEntry('modules', structure[index].sections[0].modules[0].module)
        }
        let base = {
            params: page.params,
            props: {
                ...page.props,
                nextPage: {
                    params: {
                        ...page.params,
                        section: structure[index].sections[0].section,
                        module: structure[index].sections[0].modules.length && structure[index].sections[0].modules[0].module || null,
                    },
                    props: {
                        chapterTitle: structure[index].title,
                        chapterOrder: structure[index].order,
                        sectionTitle: structure[index].sections[0].title,
                        moduleTitle: firstChapterModule?.data.name,

                    }
                }
            }
        }

        if (index > 0) {
            base.props.prevPage = {
                params: {
                    chapter: structure[index-1].chapter,
                    section: 'review',
                },
                props: {
                    chapterTitle: structure[index-1].title,
                    chapterOrder: structure[index-1].order,
                    sectionTitle: null,
                    moduleTitle: 'Check-In',
                },
            }
        }

        return base
    }))
    
  return pageLookup
}

const { 
    chapterTitle,
    structure,
} = Astro.props;

const { chapter, } = Astro.params;

async function getContent() {
  try {
    const introEntry = await getEntry('intros', `${chapter}--intro`)
    return await introEntry?.render()
  } catch (error) {
    return
  }
}

const intro = await getContent()
---
<ChapterLayout
  chaptersWithSections={structure}
  activeChapter={chapter}
  title={`${chapterTitle}: Introduction`}
  prevPage={Astro.props.prevPage}
  nextPage={Astro.props.nextPage}
  activeTitles={{
    chapter: chapterTitle,
  }}
>
  <h2 class="is-size-3 book--module-title">{chapterTitle} Introduction</h2>
  {intro && <p class="book--read-time">{intro.remarkPluginFrontmatter.minutesRead}</p> || <></>}
  <div class="chapter--intro">
      {intro && <intro.Content/> || <></>}
  </div>
</ChapterLayout>
